# =============================================================================
# KrediZeka - Ortam Değişkenleri (Örnek)
# =============================================================================
# Kullanım:
#   1. Bu dosyayı kopyalayıp '.env' olarak adlandır: cp .env.example .env
#   2. Değerleri kendi ortamına göre değiştir.
#   3. .env dosyası git'e commit EDİLMEZ (.gitignore ile korunur).
# =============================================================================

# ─── PostgreSQL Veritabanı ────────────────────────────────────────────
POSTGRES_USER=kredizeka
POSTGRES_PASSWORD=kredizeka_pass
POSTGRES_DB=kredizeka_db

# Backend bu URL ile veritabanına bağlanır
# Docker içinde host adı 'db' (servis adı), local'de 'localhost'
DATABASE_URL=postgresql+psycopg2://kredizeka:kredizeka_pass@db:5432/kredizeka_db

# ─── CORS ────────────────────────────────────────────────────────────
# Virgülle ayrılmış origin listesi (* = hepsi izinli, üretimde kısıtla)
CORS_ORIGINS=*

# ─── Varsayılan Admin Hesabı ─────────────────────────────────────────
# Sistemde hiç admin yoksa otomatik oluşturulur
DEFAULT_ADMIN_TC=11111111111
DEFAULT_ADMIN_PASSWORD=admin123

# ─── Frontend Build Zamanı Değişkenleri ──────────────────────────────
# Vite tarafından build sırasında React koduna gömülür
VITE_API_URL=http://localhost:8000
